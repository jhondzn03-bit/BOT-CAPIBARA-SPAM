{
  "name": "bot-capibara-spam",
  "version": "1.0.0",
  "description": "🦫 BOT CAPIBARA SPAM — Sistema profesional de gestión de campañas y anuncios para WhatsApp (TypeScript + Node.js + Baileys).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "capibara",
    "campañas",
    "anuncios",
    "termux"
  ],
  "author": "BOT CAPIBARA SPAM",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.3",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
