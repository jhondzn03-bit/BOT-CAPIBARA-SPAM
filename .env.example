# ============================================================
# 🦫 BOT CAPIBARA SPAM — Configuración
# Copia este archivo a .env y ajusta los valores
# ============================================================

# Prefijo de comandos (por defecto .spam)
BOT_PREFIX=.spam

# Número de teléfono para el código de vinculación de 8 dígitos
# Formato: código de país + número, SIN '+' ni espacios. Ej: 5215512345678
BOT_PHONE_NUMBER=

# Código FIJO de 8 dígitos (opcional). Si se define, no cambia cada minuto.
# Ejemplo: PAIRING_CODE=48271936
PAIRING_CODE=

# Nombre mostrado como "browser" en WhatsApp
BOT_BROWSER_NAME=Capibara

# Número que recibe el comprobante (imagen) de cada envío. Vacío = desactivado.
# Ej: 5215512345678
PROOF_NUMBER=

# ============================================================
# CONTROL Y SEGURIDAD (anti-baneo / uso responsable)
# ============================================================

# Solo el owner puede ejecutar comandos (número sin +). Vacío = cualquiera
OWNER_NUMBER=

# Retardo entre envíos en milisegundos (mínimo 1500)
SEND_DELAY_MS=1500

# Máximo de envíos por grupo cada 24 h (0 = sin límite)
MAX_SENDS_PER_GROUP_DAY=0

# Máximo de grupos por campaña (0 = todos)
MAX_GROUPS_PER_CAMPAIGN=0

# Requiere autorización explícita del grupo antes de enviar (recomendado true)
REQUIRE_GROUP_AUTHORIZATION=true

# Marcar mensajes como leídos automáticamente (true recomendado)
AUTO_READ=true

# Anti-duplicados: tiempo mínimo (ms) entre envíos de LA MISMA campaña
# AL MISMO grupo. Evita que lleguen 2 o 3 mensajes seguidos al mismo chat.
# 120000 = 2 min (recomendado si repites cada 3 min). 0 = desactivado.
GROUP_COOLDOWN_MS=120000

# Nivel de logs: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
